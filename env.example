# ============================================
# Snowflake Connection Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# Snowflake Account Information
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Optional: Snowflake Private Key Authentication (more secure)
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ============================================
# MCP Server Configuration
# ============================================
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080
MCP_SERVER_LOG_LEVEL=INFO

# ============================================
# Python Environment
# ============================================
PYTHONPATH=.
ENVIRONMENT=development

# ============================================
# Optional: External Services
# ============================================
# Add any external API keys or services here
# EXAMPLE_API_KEY=

# ============================================
# SECURITY NOTES:
# ============================================
# 1. Never commit this file with real credentials
# 2. Use environment-specific .env files (.env.dev, .env.prod)
# 3. Consider using Snowflake key-pair authentication instead of passwords
# 4. Rotate credentials regularly
# 5. Use least-privilege roles
# 6. Enable MFA on your Snowflake account

